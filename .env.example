# Copy to .env for local use, or set these in your deployment environment.

ENVIRONMENT=development

# Browser origins allowed to call this API directly. The Vite proxy makes
# development same-origin, so this only matters when the frontend is built with
# VITE_API_BASE_URL pointing here. Never use "*" in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Only enable when a trusted reverse proxy sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Requests per client IP per minute. This is in-process; use Redis or your
# gateway if you run more than one worker.
RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=32768

# Curated phrase corpus. Rules still run; this adds phrase matches and evidence.
LEXICON_ENABLED=true

# Optional LLM second opinion. Rules always run, and the model can only raise
# the score. Leave LLM_ENABLED=false to run with no external calls.
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=12
